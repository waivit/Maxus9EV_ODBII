# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Logs / captures (may contain vehicle serials / raw dumps)
*.log
captures/
logs/
*.csv
# ESP-IDF partition tables are source, not capture logs
!firmware/**/partitions.csv

# Firmware (Arduino / arduino-cli build output)
firmware/**/build/

# ESP-IDF generated per-project config (regenerated from sdkconfig.defaults)
firmware/**/sdkconfig
firmware/**/sdkconfig.old

# OS / editor
Thumbs.db
.DS_Store
