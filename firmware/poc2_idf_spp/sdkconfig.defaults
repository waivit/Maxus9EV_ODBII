# MAXUS 9 EV - ESP32 Bridge - Phase 2 Step 2 (ESP-IDF)
#
# The ELM327 adapter requires legacy PIN pairing (confirmed: Windows pairing
# needs PIN 1234, wrong PIN fails). SSP must be OFF for the Bluedroid stack to
# do legacy pairing instead of Secure Simple Pairing.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_SSP_ENABLED=n

# Controller-level mode must be BR/EDR-only (Classic only, no BLE), matching
# esp_bt_controller_enable(ESP_BT_MODE_CLASSIC_BT) in main.c - that call
# requires an EXACT match with this compiled mode or it fails with
# ESP_ERR_INVALID_ARG (the default here is dual BLE+Classic "BTDM").
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
