# MAXUS 9 EV - ESP32 Bridge - Phase 2 Step 3 (ESP-IDF coexistence POC)
#
# BT config carried over from Step 2 (firmware/poc2_idf_spp): the ELM327 needs
# legacy PIN pairing (SSP off) and Basic-Mode L2CAP, and the controller must be
# BR/EDR-only to match esp_bt_controller_enable(ESP_BT_MODE_CLASSIC_BT).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_SSP_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n

# 4 MB flash + custom partition table - WiFi + HTTP push the app past the
# default 1 MB partition, so use a ~2 MB factory app on the 4 MB chip.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Software coexistence of BT Classic + WiFi on the single 2.4 GHz radio
# (default y when both are enabled; set explicitly - this is the Step-3 gate).
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
