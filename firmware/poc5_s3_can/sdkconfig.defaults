# MAXUS 9 EV - Phase 3 (native CAN, Waveshare ESP32-S3-RS485-CAN)
#
# No Bluetooth at all: the S3 reads CAN directly, so the Phase-2 BT/WiFi
# coexistence problem simply does not exist here.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Custom partition table - WiFi + HTTP server push the dashboard build past the
# default 1 MB app partition. 16 MB of flash means we can be generous.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Console: the S3 default is UART0 primary + USB-Serial-JTAG secondary, so logs
# appear whether this board's USB-C is a UART bridge or the native USB port.
# Left at the defaults on purpose - do not pin it to one of the two.
